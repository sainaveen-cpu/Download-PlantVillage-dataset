
import java.util.Scanner;

public class CropDiseaseDetection {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.println("================================");
        System.out.println("   AI CROP DISEASE DETECTION");
        System.out.println("================================");

        System.out.println("\nSelect Crop:");
        System.out.println("1. Tomato");
        System.out.println("2. Potato");
        System.out.println("3. Pepper");

        System.out.print("\nEnter your choice: ");
        int choice = sc.nextInt();

        System.out.println("\nSelect Disease:");

        switch (choice) {

            case 1:
                System.out.println("Crop: Tomato");
                System.out.println("1. Early Blight");
                System.out.println("2. Late Blight");
                System.out.println("3. Healthy");

                int tomato = sc.nextInt();

                switch (tomato) {
                    case 1:
                        System.out.println("Result: Tomato Early Blight");
                        break;
                    case 2:
                        System.out.println("Result: Tomato Late Blight");
                        break;
                    case 3:
                        System.out.println("Result: Healthy Tomato");
                        break;
                    default:
                        System.out.println("Invalid choice");
                }
                break;

            case 2:
                System.out.println("Crop: Potato");
                System.out.println("1. Early Blight");
                System.out.println("2. Late Blight");
                System.out.println("3. Healthy");

                int potato = sc.nextInt();

                switch (potato) {
                    case 1:
                        System.out.println("Result: Potato Early Blight");
                        break;
                    case 2:
                        System.out.println("Result: Potato Late Blight");
                        break;
                    case 3:
                        System.out.println("Result: Healthy Potato");
                        break;
                    default:
                        System.out.println("Invalid choice");
                }
                break;

            case 3:
                System.out.println("Crop: Pepper");
                System.out.println("1. Bacterial Spot");
                System.out.println("2. Healthy");

                int pepper = sc.nextInt();

                switch (pepper) {
                    case 1:
                        System.out.println("Result: Pepper Bacterial Spot");
                        break;
                    case 2:
                        System.out.println("Result: Healthy Pepper");
                        break;
                    default:
                        System.out.println("Invalid choice");
                }
                break;

            default:
                System.out.println("Invalid crop choice");
        }

        sc.close();
    }
}

